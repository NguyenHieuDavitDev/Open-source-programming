<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Danh sách sản phẩm</title>
    <!-- Bootstrap CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      /* CSS tùy chỉnh cho bảng */
      .custom-table {
        border-collapse: separate;
        border-spacing: 0;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        overflow: hidden;
      }
      .custom-table thead {
        background-color: #007bff; /* Màu xanh đậm */
        color: #fff;
      }
      .custom-table thead th {
        padding: 12px 15px;
        text-align: center;
      }
      .custom-table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
        text-align: center;
      }
      .custom-table tbody tr {
        transition: background-color 0.3s ease;
      }
      .custom-table tbody tr:nth-child(even) {
        background-color: #f2f2f2;
      }
      .custom-table tbody tr:hover {
        background-color: #d1ecf1; /* Màu xanh nhạt */
      }
      /* Hiệu ứng cho hình ảnh sản phẩm */
      .product-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        transition: transform 0.3s ease;
      }
      .product-image:hover {
        transform: scale(1.1);
      }
    </style>
  </head>
  <body>
    <div class="container mt-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
          <i class="fa-solid fa-boxes-stacked me-2"></i>Danh sách sản phẩm
        </h1>
        <div>
          <a href="/products/add" class="btn btn-success me-2">
            <i class="fa-solid fa-plus me-1"></i> Thêm sản phẩm
          </a>
          <a href="/products/deleted" class="btn btn-warning">
            <i class="fa-solid fa-trash-can me-1"></i> Sản phẩm đã xóa
          </a>
        </div>
      </div>
      <table class="table custom-table">
        <thead>
          <tr>
            <th>Hình ảnh</th>
            <th>Tên</th>
            <th>Giá</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
          <tr>
            <td>
              <% if (product.image) { %>
              <img
                src="/uploads/<%= product.image %>"
                alt="<%= product.name %>"
                class="product-image img-thumbnail"
              />
              <% } else { %>
              <img
                src="https://via.placeholder.com/80"
                alt="No Image"
                class="product-image img-thumbnail"
              />
              <% } %>
            </td>
            <td><%= product.name %></td>
            <td><%= product.price %></td>
            <td>
              <a
                href="/products/edit/<%= product.id %>"
                class="btn btn-primary btn-sm me-1"
              >
                <i class="fa-solid fa-pen-to-square"></i>
              </a>
              <a
                href="/products/delete/<%= product.id %>"
                onclick="return confirm('Xóa sản phẩm?');"
                class="btn btn-danger btn-sm"
              >
                <i class="fa-solid fa-trash"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
