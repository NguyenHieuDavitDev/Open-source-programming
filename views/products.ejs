<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý sản phẩm</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      body {
        display: flex;
        background-color: #f8f9fa;
      }
      #sidebar {
        width: 250px;
        height: 100vh;
        background: #343a40;
        color: white;
        padding: 15px;
        position: fixed;
      }
      #sidebar a {
        color: white;
        display: block;
        padding: 10px;
        text-decoration: none;
      }
      #sidebar a:hover {
        background: #495057;
        border-radius: 6px;
      }
      .content {
        margin-left: 260px;
        padding: 20px;
        width: 100%;
      }
      .table-container {
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0px 3px 10px rgba(0, 0, 0, 0.1);
      }
      .btn-primary {
        border-radius: 6px;
        font-weight: bold;
      }
      .btn-primary:hover {
        transform: scale(1.05);
        transition: 0.2s;
      }
      #product-form {
        display: none;
      }
      /* Các style cho search suggestions */
      .position-relative {
        position: relative;
      }
      #suggestions {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #ccc;
        border-top: none;
        z-index: 9999;
        max-height: 300px;
        overflow-y: auto;
        display: none;
      }
      #suggestions .list-group-item {
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <!-- Sidebar -->
    <div id="sidebar">
      <h3><i class="fa-solid fa-boxes-stacked"></i> Admin</h3>
      <a href="/products"><i class="fa-solid fa-box"></i> Sản phẩm</a>
    </div>

    <!-- Nội dung chính -->
    <div class="content">
      <h2 class="text-center">
        <i class="fa-solid fa-box-open"></i> Quản lý Sản phẩm
      </h2>

      <!-- Form tìm kiếm & bộ lọc -->
      <form method="GET" class="row mb-3" id="search-form" autocomplete="off">
        <div class="col-md-5 position-relative">
          <!-- Input group với icon kính lúp -->
          <div class="input-group">
            <input
              type="text"
              name="search"
              id="search-input"
              class="form-control"
              placeholder="Nhập từ khóa tìm kiếm..."
              value="<%= search || '' %>"
            />
            <button class="btn btn-outline-secondary" type="button" id="search-btn">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
          <!-- Container gợi ý -->
          <div id="suggestions" class="list-group"></div>
        </div>
        <div class="col-md-3">
          <select name="sort" class="form-select">
            <option value="">Sắp xếp</option>
            <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>
              Giá tăng dần
            </option>
            <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>
              Giá giảm dần
            </option>
            <option value="discount_asc" <%= sort === 'discount_asc' ? 'selected' : '' %>>
              Giảm giá ít nhất
            </option>
            <option value="discount_desc" <%= sort === 'discount_desc' ? 'selected' : '' %>>
              Giảm giá nhiều nhất
            </option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter"></i> Lọc
          </button>
        </div>
      </form>

      <!-- Nút thêm sản phẩm -->
      <button class="btn btn-primary mb-3" id="add-product-btn">
        <i class="fa-solid fa-plus"></i> Thêm sản phẩm
      </button>

      <!-- Danh sách sản phẩm -->
      <div class="table-container">
        <table class="table table-bordered text-center">
          <thead class="table-dark">
            <tr>
              <th>Hình ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Giá</th>
              <th>Giảm giá</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
            <tr>
              <td>
                <% if (p.image) { %>
                <img
                  src="/uploads/<%= p.image %>"
                  width="50"
                  class="shadow-sm"
                />
                <% } else { %>
                <i class="fa-solid fa-image-slash"></i> Không có ảnh
                <% } %>
              </td>
              <td><%= p.name %></td>
              <td><%= p.price %>₫</td>
              <td><%= p.discount %>%</td>
              <td>
                <button
                  class="btn btn-warning btn-sm edit-btn"
                  data-id="<%= p.id %>"
                  data-name="<%= p.name %>"
                  data-price="<%= p.price %>"
                  data-discount="<%= p.discount %>"
                  data-image="<%= p.image %>"
                >
                  <i class="fa-solid fa-pen-to-square"></i> Sửa
                </button>
                <button
                  class="btn btn-danger btn-sm delete-btn"
                  data-id="<%= p.id %>"
                >
                  <i class="fa-solid fa-trash"></i> Xóa
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Phân trang (giữ nguyên) -->
      <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
          <% 
            let curPage = typeof currentPage !== 'undefined' ? currentPage : 1;
            let totPages = typeof totalPages !== 'undefined' ? totalPages : 1;
          %>
          <% if (curPage > 1) { %>
          <li class="page-item">
            <a
              class="page-link"
              href="?search=<%= search %>&sort=<%= sort %>&page=<%= curPage - 1 %>"
              aria-label="Previous"
            >
              <span aria-hidden="true">&laquo;</span>
            </a>
          </li>
          <% } %>
          <% for (let i = 1; i <= totPages; i++) { %>
          <li class="page-item <%= i === curPage ? 'active' : '' %>">
            <a class="page-link" href="?search=<%= search %>&sort=<%= sort %>&page=<%= i %>">
              <%= i %>
            </a>
          </li>
          <% } %>
          <% if (curPage < totPages) { %>
          <li class="page-item">
            <a
              class="page-link"
              href="?search=<%= search %>&sort=<%= sort %>&page=<%= curPage + 1 %>"
              aria-label="Next"
            >
              <span aria-hidden="true">&raquo;</span>
            </a>
          </li>
          <% } %>
        </ul>
      </nav>

      <!-- Form thêm/sửa sản phẩm -->
      <div class="card p-3 mt-3" id="product-form">
        <h3 id="form-title"><i class="fa-solid fa-plus"></i> Thêm sản phẩm</h3>
        <form method="POST" action="/products/add" enctype="multipart/form-data">
          <input type="hidden" name="id" />
          <div class="mb-2">
            <label class="form-label">Tên sản phẩm</label>
            <input type="text" name="name" class="form-control" required />
          </div>
          <div class="mb-2">
            <label class="form-label">Giá</label>
            <input type="number" name="price" class="form-control" required />
          </div>
          <div class="mb-2">
            <label class="form-label">Giảm giá (%)</label>
            <input type="number" name="discount" class="form-control" />
          </div>
          <div class="mb-2">
            <label class="form-label">Hình ảnh</label>
            <input type="file" name="image" class="form-control" />
            <div id="current-image"></div>
          </div>
          <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-floppy-disk"></i> Lưu
          </button>
        </form>
      </div>
    </div>

    <script>
      // Submit form khi nhấn vào icon kính lúp
      document.getElementById("search-btn").addEventListener("click", function () {
        document.getElementById("search-form").submit();
      });

      // Live suggestions cho ô tìm kiếm
      const searchInput = document.getElementById("search-input");
      const suggestionsBox = document.getElementById("suggestions");

      searchInput.addEventListener("input", function () {
        const query = this.value.trim();
        if (query.length === 0) {
          suggestionsBox.innerHTML = "";
          suggestionsBox.style.display = "none";
          return;
        }
        // Gọi endpoint /products/suggestions?query=...
        fetch("/products/suggestions?query=" + encodeURIComponent(query))
          .then((res) => res.json())
          .then((data) => {
            if (data && data.length > 0) {
              let html = "";
              data.forEach((item) => {
                // Giả sử mỗi item có { id, name, image }
                html +=
                  '<a href="/products/' +
                  item.id +
                  '" class="list-group-item list-group-item-action">' +
                  (item.image
                    ? '<img src="/uploads/' +
                      item.image +
                      '" width="30" class="me-2" />'
                    : '<i class="fa-solid fa-box me-2"></i>') +
                  item.name +
                  "</a>";
              });
              suggestionsBox.innerHTML = html;
              suggestionsBox.style.display = "block";
            } else {
              suggestionsBox.innerHTML = "";
              suggestionsBox.style.display = "none";
            }
          })
          .catch((err) => {
            console.error(err);
            suggestionsBox.innerHTML = "";
            suggestionsBox.style.display = "none";
          });
      });

      // Ẩn suggestions khi click bên ngoài
      document.addEventListener("click", function (e) {
        if (!document.getElementById("search-input").contains(e.target)) {
          suggestionsBox.style.display = "none";
        }
      });

      // Submit form khi nhấn Enter trong ô tìm kiếm
      searchInput.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
          document.getElementById("search-form").submit();
        }
      });

      // Các xử lý form thêm/sửa sản phẩm
      document.getElementById("add-product-btn").addEventListener("click", function () {
        const form = document.getElementById("product-form");
        form.style.display =
          form.style.display === "none" || form.style.display === "" ? "block" : "none";
        if (form.style.display === "block") {
          document.getElementById("form-title").innerHTML =
            '<i class="fa-solid fa-plus"></i> Thêm sản phẩm';
          document.querySelector("#product-form form").action = "/products/add";
          document.querySelector("#product-form form").reset();
          document.getElementById("current-image").innerHTML = "";
        }
      });

      document.querySelectorAll(".edit-btn").forEach((btn) => {
        btn.addEventListener("click", function () {
          const form = document.getElementById("product-form");
          form.style.display = "block";
          const productId = this.dataset.id;
          const productName = this.dataset.name;
          const productPrice = this.dataset.price;
          const productDiscount = this.dataset.discount;
          const productImage = this.dataset.image;
          document.getElementById("form-title").innerHTML =
            '<i class="fa-solid fa-edit"></i> Sửa sản phẩm';
          document.querySelector("#product-form form").action = "/products/update/" + productId;
          document.querySelector('input[name="id"]').value = productId;
          document.querySelector('input[name="name"]').value = productName;
          document.querySelector('input[name="price"]').value = productPrice;
          document.querySelector('input[name="discount"]').value = productDiscount;
          if (productImage) {
            document.getElementById("current-image").innerHTML =
              '<img src="/uploads/' +
              productImage +
              '" width="80" class="mt-2 shadow-sm"/>';
          } else {
            document.getElementById("current-image").innerHTML = "";
          }
        });
      });

      document.querySelectorAll(".delete-btn").forEach((btn) => {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          const productId = this.dataset.id;
          Swal.fire({
            title: "Bạn có chắc chắn?",
            text: "Sản phẩm sẽ bị xóa!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Xóa ngay!",
            cancelButtonText: "Hủy",
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = "/products/delete/" + productId;
            }
          });
        });
      });
    </script>
  </body>
</html>
